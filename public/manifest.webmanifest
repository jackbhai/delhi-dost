{
  "name": "Delhi DOST — Bus, Metro, Train & Live Buses",
  "short_name": "Delhi DOST",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#0B0F17",
  "theme_color": "#0B0F17",
  "description": "Delhi travel companion — bus routes & timetables, live buses on a map, metro fares with first & last trains, live train status, multi-modal journey planner, near-me places and travel help. No login, works offline.",
  "categories": ["travel", "navigation", "utilities"],
  "dir": "ltr",
  "lang": "en",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "handle_links": "preferred",
  "icons": [
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Live Buses — map", "short_name": "Live Buses", "url": "./#livebus",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Bus routes & timetables", "short_name": "Bus", "url": "./#bus",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Metro — fares & first/last trains", "short_name": "Metro", "url": "./#metro",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Live train status", "short_name": "Trains", "url": "./#train",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
